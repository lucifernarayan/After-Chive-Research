    "else:\n",
    "    print(\"WARNING: Running on CPU. Ensure GPU accelerator (T4) is enabled in Colab Runtime Settings.\")\n",
    "\n",
    "# Set HF_TOKEN environment variable from Colab Secrets if available\n",
