    "# Step 3: Run Full Phase 2A Real Gemma Instrument Validation Suite\n",
    "from experiments.phase2_instrument_validation import Phase2InstrumentValidator\n",
    "from target.gemma import GemmaTargetInterface\n",
    "\n",
    "# Auto-detect mock mode if CUDA is unavailable\n",
    "use_mock = not torch.cuda.is_available()\n",
    "\n",
    "target = GemmaTargetInterface(model_id=\"google/gemma-2-2b-it\", mock=use_mock)\n",
    "validator = Phase2InstrumentValidator(target_model=target, mock=use_mock, output_dir=\"results/phase2\")\n",
    "\n",
    "results = validator.execute_validation()"
   ]
